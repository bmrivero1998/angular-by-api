[
  {
    "id_DocumentHTMLCSS": "tw-contacto",
    "renderType": "dynamic",
    "formId": "contacto",
    "htmlComponent": "<form class=\"max-w-md mx-auto bg-white rounded-xl shadow-lg p-6 space-y-4\"><h2 class=\"text-2xl font-bold text-slate-800\">Contacto</h2><p class=\"text-sm text-slate-500\">Estilos de Tailwind, sin una sola línea de CSS en el JSON.</p><div><label for=\"nombre\" class=\"block text-sm font-medium text-slate-700\">Nombre</label><input id=\"nombre\" class=\"mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500\" /><p data-error-for=\"nombre\" class=\"mt-1 text-xs text-red-600\"></p></div><div><label for=\"correo\" class=\"block text-sm font-medium text-slate-700\">Correo</label><input id=\"correo\" class=\"mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500\" /><p data-error-for=\"correo\" class=\"mt-1 text-xs text-red-600\"></p></div><button type=\"submit\" class=\"w-full rounded-lg bg-indigo-600 px-4 py-2 font-semibold text-white hover:bg-indigo-700 disabled:opacity-50\">Enviar</button></form>",
    "formMappings": [
      {
        "controlName": "nombre",
        "domSelector": "#nombre",
        "errorDisplaySelector": "[data-error-for='nombre']",
        "validatorConfig": [{ "type": "required", "message": "Escribe tu nombre" }]
      },
      {
        "controlName": "correo",
        "domSelector": "#correo",
        "errorDisplaySelector": "[data-error-for='correo']",
        "validatorConfig": [
          { "type": "required", "message": "Escribe tu correo" },
          { "type": "email", "message": "Correo inválido" }
        ]
      }
    ]
