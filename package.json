{
  "name": "ux-driven-viewer",
  "version": "1.0.3",
  "description": "Motor de UI dinámica (Backend-Driven UI) empaquetado como custom element de Angular.",
  "scripts": {
    "start": "ng serve playground",
    "build": "npm run build:engine && npm run build:runtime",
    "build:engine": "ng build engine",
    "build:runtime": "ng build runtime --configuration=production --output-hashing=none && node scripts/build-elements.js",
    "build:runtime:dev": "ng build runtime --configuration=development && node scripts/build-elements.js",
    "test": "npm run test:engine && npm run test:runtime",
    "test:engine": "ng test engine",
    "test:runtime": "ng test runtime",
    "test:ci": "ng test engine --watch=false --browsers=ChromeHeadlessCI && ng test runtime --watch=false --browsers=ChromeHeadlessCI",
    "mock-api": "node scripts/mock-api.js",
    "test:e2e": "node --test e2e/viewer.e2e.test.js"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/elements": "^19.2.13",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "dompurify": "^3.4.14",
    "ngx-build-plus": "^19.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.13",
    "@angular/cli": "^19.2.13",
    "@angular/compiler-cli": "^19.2.0",
    "@types/dompurify": "^3.2.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "playwright": "^1.63.0",
    "typescript": "~5.7.2"
  },
  "license": "MIT"
}
